# Boreas — all keys optional; features degrade gracefully when unset.

# NASA FIRMS map key (free: https://firms.modaps.eosdis.nasa.gov/api/)
# Unset = wildfire satellite detections absent (EONET events still shown).
VITE_FIRMS_MAP_KEY=

# Windy webcams key (free: https://api.windy.com/keys). Unset = no webcams.
VITE_WINDY_KEY=

# Contact email sent to Nominatim per its usage policy. Set to a real address
# you own before deploying publicly. Unset = param omitted.
VITE_NOMINATIM_CONTACT=

# Umami analytics (free cloud tier). Both required to activate.
VITE_UMAMI_SRC=
VITE_UMAMI_ID=

# Sentry error reporting (free tier). Unset = disabled.
VITE_SENTRY_DSN=
